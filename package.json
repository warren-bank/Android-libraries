{
  "name": "@warren-bank/android-folder-picker-library",
  "private": true,
  "license": "GPL-2.0",
  "devDependencies": {
    "@warren-bank/translate-android-strings": "^3.0.1"
  },
  "scripts": {
    "translate:lib": "translate-android-strings -s \"deepl\" -i \"en\" -f \"library/folderpicker-library/src/main/res/values/strings.xml\" -d \"library/folderpicker-library/src/withAllLanguageTranslations/res\" -m --na --nc --nw --nr -b \"(?:\\\\'|: [\\x25]s)\"",
    "translate:app": "translate-android-strings -s \"deepl\" -i \"en\" -f \"library/folderpicker-sample/src/main/res/values/strings.xml\"  -d \"library/folderpicker-sample/src/withAllLanguageTranslations/res\"  -m --na --nc --nw --nr -b \"(?:PNG|JSON)\"",
    "translate:all": "npm run translate:lib && npm run translate:app",

    "translate:debug:lib": "npm run translate:lib -- -o \"en\" --debug",
    "translate:debug:app": "npm run translate:app -- -o \"en\" --debug",
    "translate:debug:all": "npm run translate:debug:lib && npm run translate:debug:app"
  }
}
