<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="net.rdrei.android.dirchooser.sample">

    <!-- file access permissions: Android 1 to 10 -->
    <!-- note: Android 10 requires "requestLegacyExternalStorage" -->
    <uses-permission android:maxSdkVersion="29" android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- file access permissions: Android 11+ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/DirectoryChooserTheme">

        <activity
            android:name=".DirChooserSample"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- parentActivityName is API 16+ -->
        <activity
            android:name=".DirChooserFragmentSample"
            android:parentActivityName=".DirChooserSample"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize"
            tools:ignore="UnusedAttribute"
            android:exported="false" />

        <activity
            android:name="net.rdrei.android.dirchooser.DirectoryChooserActivity"
            android:exported="false" />

    </application>
</manifest>
